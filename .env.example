# Frontend — Supabase connection (pre-populated, do not change)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Backend — TinyFish API key (set as edge function secret, NOT here)
# This key is read server-side only by the tinyfish-search edge function.
# Get yours at: https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=your_tinyfish_api_key_here
